# ==============================================================================
# Exemplo de variaveis de ambiente (Trilha B - Qualidade do Ar - UBC)
# Copie este arquivo para .env caso queira sobrescrever config/params.yaml
# ==============================================================================

# Coordenadas do ponto de referencia (Universidade Braz Cubas - Mogi das Cruzes/SP)
OPENMETEO_LATITUDE=-23.514561
OPENMETEO_LONGITUDE=-46.186832
OPENMETEO_TIMEZONE=America/Sao_Paulo

# Endpoints das APIs publicas Open-Meteo (nao exigem chave secreta no plano gratuito)
OPENMETEO_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1/air-quality
OPENMETEO_WEATHER_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPENMETEO_WEATHER_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPENMETEO_TIMEOUT_SECONDS=30

# Caminhos de armazenamento e artefato de modelo
RAW_DATA_DIR=data/raw
INTERIM_DATA_DIR=data/interim
PROCESSED_DATA_DIR=data/processed
MODEL_ARTIFACT_PATH=models/modelo_final_sprint5.joblib
DECISION_THRESHOLD=0.30

